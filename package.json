{
  "name": "context-layer",
  "version": "0.2.0-draft.1",
  "private": true,
  "description": "Draft Context Layer protocol, reference artifacts, and local-first core.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sierracatalina/context-layer.git"
  },
  "homepage": "https://sierracatalina.com/context-layer",
  "bugs": {
    "url": "https://github.com/sierracatalina/context-layer/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node node_modules/vinext/dist/cli.js dev",
    "build": "node node_modules/vinext/dist/cli.js build",
    "start": "node node_modules/vinext/dist/cli.js start",
    "test": "npm run build && npm run test:contracts && npm run test:local-core && npm run test:proof",
    "test:contracts": "node --test tests/rendered-html.test.mjs tests/reference-implementation.test.mjs",
    "test:local-core": "node --test tests/local-core.test.mjs tests/receipt-log-hardening.test.mjs",
    "test:proof": "node --test tests/local-core-demo.test.mjs tests/test-vectors.test.mjs",
    "demo:local-core": "node examples/local-core-demo.mjs",
    "release:hygiene": "node scripts/release-hygiene.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
